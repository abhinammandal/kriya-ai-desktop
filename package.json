{
  "name": "kriya-ai-desktop",
  "version": "2.0.0",
  "description": "A personalized background gesture controller for Windows",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinammandal/kriya-ai-desktop.git"
  },
  "keywords": [
    "gesture-control",
    "computer-vision",
    "electron",
    "accessibility",
    "desktop-automation"
  ],
  "author": "Abhinam Mandal",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/abhinammandal/kriya-ai-desktop/issues"
  },
  "homepage": "https://github.com/abhinammandal/kriya-ai-desktop#readme",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.abhinammandal.kriyaai",
    "productName": "KRIYA AI",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "script.js",
      "electron-main.js",
      "preload.js",
      "desktop-actions.js",
      "foreground-profile.js",
      "windows-input.ps1",
      "foreground-app.ps1",
      "assets/kriya-ai.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/kriya-ai.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KRIYA-AI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KRIYA AI",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}